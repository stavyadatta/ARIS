# Copy to .env and fill in. Never commit .env.

# --- Server ---
# Reasoner, speech, vision and embedding models (OpenAI)
OPENAI_API_KEY=
# Optional fallback LLM (xAI Grok) used when an OpenAI call fails
GROK_API_KEY=
# Password for the bundled Neo4j instance
NEO4J_PASSWORD=change-me

# --- Pepper client ---
# Pepper's IP address
PEPPER_IP=192.168.0.52
# host:port of the ARIS server as seen from the client machine
ARIS_SERVER=192.168.0.10:50051
# qi endpoint on the client machine that Pepper can reach (audio callbacks)
CLIENT_LISTEN_URL=tcp://0.0.0.0:9559
# Speaker volume (0-100)
PEPPER_VOLUME=40
